{
  "name": "fundamental-information-technology-engineer-examination",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "基本情報技術者試験（FE）完全学習Webアプリ",
  "scripts": {
    "content": "node tools/run-ts.mjs tools/build-content.ts",
    "dev": "npm run content && vite",
